# Copy to .env and change every value marked CHANGE. Never commit .env.

# PostgreSQL password for the bundled database container.  CHANGE
POSTGRES_PASSWORD=change-this-db-password

# Signs login tokens. Use a long random string, e.g. output of:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   CHANGE
CLPI_SECRET_KEY=change-this-to-a-long-random-string

# First administrator, created only when the database has no users.  CHANGE
CLPI_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CLPI_BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password

# Port the UI is published on (http://localhost:8088).
CLPI_WEB_PORT=8088

# Optional: Claude for description extraction and plain-language explanations.
# Leave blank to run without AI; every pricing feature still works.
CLPI_ANTHROPIC_API_KEY=
CLPI_ANTHROPIC_MODEL=claude-opus-5-5

# Upload size limit in MB.
CLPI_MAX_UPLOAD_MB=10

# Pricing Intelligence: live market research through a licensed search API (optional).
# Without a key, research is disabled and pricing uses verified manual quotes, recorded
# transactions and historical reference valuations only. Keys stay on the server.
#   Brave Search API: https://api.search.brave.com      Tavily: https://tavily.com
CLPI_BRAVE_API_KEY=
CLPI_TAVILY_API_KEY=
# brave | tavily (default: the first configured)
CLPI_RESEARCH_PROVIDER=

# Optional one-time historical reference import; mount only approved completed dated workbooks.
# Docker example: CLPI_REFERENCE_DIRS=["/data/references"]
CLPI_REFERENCE_DIRS=[]
# Optional approved catalog JSON file, mounted under references/. Requires explicit authorization.
CLPI_APPROVED_CATALOG_PATH=
CLPI_APPROVED_CATALOG_TERMS_CONFIRMED=false
